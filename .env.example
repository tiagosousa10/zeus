# A instalação normal gera as chaves locais automaticamente; não é necessário .env.
# Para desenvolvimento, caminhos e serviços externos são opcionais.
# ZEUS_DATA_DIR=/caminho/privado/Zeus
# ZEUS_DATABASE_PATH=/caminho/privado/Zeus/zeus.sqlite
ZEUS_WEB_ORIGIN=http://127.0.0.1:5174
BETTER_AUTH_URL=http://127.0.0.1:5174
PORT=4310
# BETTER_AUTH_SECRET=<manter-a-chave-existente-ou-gerar-uma-chave-forte>
# ZEUS_ENCRYPTION_KEY=<64-caracteres-hexadecimais>
# ZEUS_MOTOR_TOKEN=<chave-aleatoria>
# RESEND_API_KEY=
# RESEND_FROM=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=
# Só para a migração de instalações antigas; nunca necessário para executar a app:
# ZEUS_LEGACY_DATABASE_URL=postgres://zeus:zeus_local@127.0.0.1:55439/zeus
