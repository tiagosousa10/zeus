{
  "name": "zeus",
  "productName": "Zeus",
  "version": "1.2.7",
  "description": "Zeus — Cinema e TV, no teu universo",
  "main": "apps/desktop/src/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dist": "npm run build && node apps/desktop/scripts/package-desktop.cjs",
    "dist:arm": "npm run dist -- --arm64",
    "brand": "node apps/desktop/scripts/brand-dev.js",
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts apps/api/test/*.test.ts apps/desktop/test/*.test.ts",
    "build": "npm run build:web && npm run build:api",
    "build:api": "node scripts/build-api.mjs",
    "db:setup": "node --env-file-if-exists=.env --import tsx apps/api/src/db/setup.ts",
    "test:browser": "node tests/browser.mjs",
    "test:visual": "node tests/visual-fidelity.mjs",
    "test:tv": "node tests/tv-browser.mjs",
    "test:performance": "npm run build:web && node tests/performance.mjs --check",
    "dist:intel": "npm run dist -- --x64",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate-postgres.mts",
    "test:desktop": "node apps/desktop/test/desktop.mjs",
    "test:ui": "node tests/modern-ui.mjs",
    "test:header": "node tests/header-layout.mjs",
    "test:cinema": "node tests/cinema-playback.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.21",
    "@hono/node-server": "^2.1.7",
    "better-auth": "^1.7.21",
    "drizzle-orm": "^0.45.4",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.13.18",
    "webtorrent": "^3.0.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "gsap": "^3.15.1",
    "hls.js": "^1.7.4",
    "mpegts.js": "^1.8.2",
    "postgres": "^4.1.1",
    "prettier": "^3.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1"
  },
  "private": true
}
